e\" stretchy=\"true\" minsize=\"1.8em\" maxsize=\"1.8em\">]</mo><mo fence=\"true\" stretchy=\"true\" minsize=\"1.8em\" maxsize=\"1.8em\">∣</mo><msup><mo fence=\"true\" stretchy=\"true\" minsize=\"3em\" maxsize=\"3em\">}</mo><mrow><mn>1</mn><mi mathvariant=\"normal\">/</mi><mo stretchy=\"false\">∣</mo><msub><mi>o</mi><mi>i</mi></msub><mo stretchy=\"false\">∣</mo></mrow></msup><mi mathvariant=\"normal\">sgn</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><msub><mover accent=\"true\"><mi>A</mi><mo stretchy=\"true\">^</mo></mover><mi>i</mi></msub><mo stretchy=\"false\">)</mo><mi mathvariant=\"normal\">.</mi></mrow></mstyle></mtd></mtr></mtable><annotation encoding=\"application/x-tex\">\n\\begin{aligned}\nJ_{\\mathrm{GMPO}}(\\pi_\\theta)\n&amp;= \\mathbb{E}_{q,\\{o_i\\}\\sim\\pi_{\\mathrm{old}}}\n\\frac{1}{G}\\sum_{i=1}^{G}\n\\Biggl\\{\\prod_{t=1}^{\\lvert o_i\\rvert}\n\\Bigl|\\min\\Bigl[\n\\rho_{i,t}(\\theta)\\widehat{A}_i,\\\\\n&amp;\\qquad\\operatorname{clip}\\bigl(\\rho_{i,t}(\\theta),\\epsilon_{\\mathrm{low}},\\epsilon_{\\mathrm{high}}\\bigr)\\widehat{A}_i\n\\Bigr]\\Bigr|\\Biggr\\}^{1/\\lvert o_i\\rvert}\n\\operatorname{sgn}(\\widehat{A}_i).\n\\end{aligned}\n</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:6.8166em;vertical-align:-3.1583em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.6583em;\"><span style=\"top:-5.7252em;\"><span class=\"pstrut\" style=\"height:4.0279em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0962em;\">J</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-left:-0.0962em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;