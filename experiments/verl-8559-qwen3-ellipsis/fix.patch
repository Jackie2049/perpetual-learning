+
+
+@pytest.mark.parametrize("raw_value", ["...", "{1, 2}", "b'abc'", "1+2j"])
+def test_non_json_literal_degenerates_to_string(raw_value):
+    """Python literals without a JSON representation must not crash the parser.
+
+    Regression test for the model emitting ``...`` as a parameter value: ``ast.literal_eval``
+    returns ``Ellipsis``, ``json.dumps`` raised ``TypeError`` and the whole tool call was dropped.
+    Sets, bytes and complex numbers take the same path.
+    """
+    result = _parse_single_param("array", raw_value)
+    assert json.loads(result.arguments)["items"] == raw_value
+
+
+def test_ellipsis_parameter_keeps_the_tool_call():
+    """End to end: one un-serialisable parameter must not drop the tool call.
+
+    ``extract_tool_calls`` swallows parser errors and returns no tool calls at all,
+    so a per-parameter failure used to cost the whole turn.
+    """
+    parser = Qwen3XMLToolParser(tokenizer=None)
+    tool = _make_tool("items", "array")
+
+    class _FixedTextTokenizer:
+        def decode(self, token_ids):
+            return "<tool_call><function=list_tool><parameter=items>...</parameter></function></tool_call>"
+
+    parser.tokenizer = _FixedTextTokenizer()
+
+    _, tool_calls = asyncio.run(parser.extract_tool_calls([0], [tool]))
+
+    assert len(tool_calls) == 1
+    assert json.loads(tool_calls[0].arguments)["items"] == "..."
