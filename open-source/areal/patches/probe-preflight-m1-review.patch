+def norm(values):
+    return math.sqrt(sum(float(value.double().square().sum())
+                         for value in values.values() if value is not None))
+
+
+def digest(values):
+    result = hashlib.sha256()
+    for name, value in sorted(values.items()):
+        result.update(name.encode())
+        result.update(b"none" if value is None else value.contiguous().numpy().tobytes())
+    return result.hexdigest()
+
+
+def compare(left, right):
+    if left.keys() != right.keys():
+        raise ValueError("Parameter keys changed")
+    squared = maximum = 0.0
+    for name in left:
+        if (left[name] is None) != (right[name] is None):
+            raise ValueError(f"Gradient presence changed: {name}")
+        if left[name] is not None:
+            diff = left[name].double() - right[name].double()
+            squared += float(diff.square().sum())
+            maximum = max(maximum, float(diff.abs().max()))
+    difference = math.sqrt(squared)
+    reference = norm(left)
+    return {"l2_difference": difference, "max_abs_difference": maximum,
+            "reference_l2": reference,
+            "relative_l2": difference / reference if reference else None}
+
