+def run_one(args, spec, m, p, mode):
+    import torch
+    from areal.api.io_struct import FinetuneSpec
+    from areal.api.cli_args import (MicroBatchSpec, OptimizerConfig,
+                                   PPOActorConfig, TrainEngineConfig)
+    from areal.engine.fsdp_engine import FSDPEngine
+    from areal.trainer.ppo.actor import PPOActor
+    from areal.utils import stats_tracker
+    torch.manual_seed(0)
+    engine = FSDPEngine(TrainEngineConfig(
+        path=args.model, experiment_name="prompt-mean-probe", trial_name="controlled",
+        backend="fsdp:d1", dtype=args.dtype, attn_impl="flash_attention_2",
+        disable_dropout=True, mb_spec=MicroBatchSpec(n_mbs=1),
+        optimizer=OptimizerConfig(type="adam", lr=1e-4, weight_decay=0.0,
+                                  warmup_steps=0, gradient_clipping=args.clip),
+    ))
+    process_group_created = False
+    try:
+        engine.create_process_group()
+        process_group_created = True
+        engine.initialize(None, FinetuneSpec(
+            total_train_epochs=1, dataset_size=spec["responses"] * 8,
+            train_batch_size=spec["responses"],
+        ))
+        before = cpu_values(engine.model)
+        initial_digest = digest(before)
+        actor = PPOActor(PPOActorConfig(
+            loss_aggregation=mode, ppo_n_minibatches=m, eps_clip=0.2,
+            temperature=1.0, adv_norm=None, m2_threshold=None,
+        ), engine)
+        groups = make_groups(spec)
+        # Reference probabilities always use the SAME P=1 eval path before training.
+        with torch.no_grad():
+            old_logps = actor.compute_logp(groups)
+        if old_logps is None or len(old_logps) != len(groups):
+            raise RuntimeError("Unexpected compute_logp output")
+        for group, old in zip(groups, old_logps):
+            if old.shape != group["logprobs"].shape:
+                raise RuntimeError("Log-probability alignment/shape requires review")
+            group["logprobs"] = old.detach().cpu().clone()
+            group["prox_logp"] = old.detach().cpu().clone()
+        batch_digest = digest({
+            f"{i}:{key}": value for i, group in enumerate(groups)
+            for key, value in group.items()
+        })
+        engine.config.mb_spec = MicroBatchSpec(n_mbs=p)
+        records, first_gradient = [], {}
+        optimizer_step, train_batch = engine.optimizer_step, engine.train_batch
+        def measured_step():
+            nonlocal first_gradient
+            gradients = cpu_values(engine.model, gradients=True)
+            pre_clip = norm(gradients)
+            if not first_gradient:
+                first_gradient = gradients
+            result = optimizer_step()
+            post_clip = norm(cpu_values(engine.model, gradients=True))
+            records.append({"pre_clip_l2": pre_clip, "post_clip_l2": post_clip,
+                            **{key: float(value) for key, value in result.items()}})
+            return result
+        def measured_batch(batch, **kwargs):
+            result = train_batch(batch, **kwargs)
+            records[-1]["inner_microbatches"] = int(result["num_micro_batches"])
+            return result
+        engine.optimizer_step, engine.train_batch = measured_step, measured_batch
+        actor.ppo_update(groups)
+        if len(records) != m or any(row["inner_microbatches"] != p for row in records):
+            raise RuntimeError(f"Requested M={m}/P={p} was not realized: {records}")
+        if any(not row["update_successful"] for row in records):
+            raise RuntimeError("Optimizer skipped an update")
+        after = cpu_values(engine.model)
+        deltas = {name: after[name] - before[name] for name in before}
+        summary = {"M": m, "P": p, "mode": mode, "fixture": spec["kind"],
+                   "initial_weights_sha256": initial_digest,
+                   "batch_sha256": batch_digest, "delta_l2": norm(deltas),
+                   "first_gradient_l2": norm(first_gradient), "steps": records}
+        stats_tracker.export_all(reduce_group=engine.data_parallel_group, reset=True)
+        return summary, deltas, first_gradient
+    finally:
+        if process_group_created:
+            engine.destroy()


